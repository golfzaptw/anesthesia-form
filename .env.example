# Set to 1 to run entirely on localStorage with no Firebase project (demo/testing).
# Leave unset once the real credentials below are filled in.
NEXT_PUBLIC_MOCK=1

# Comma-separated emails allowed into /admin. Leave empty to allow all signed-in users.
NEXT_PUBLIC_ADMIN_EMAILS=

# Firebase - copy to .env.local and fill in your project values
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
